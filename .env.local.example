NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: enables real AI-powered image analysis on /analyze.
# Without this, analysis still works end-to-end but returns a clearly-labeled
# simulated result instead of a genuine AI critique.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: enables real Meta Ads OAuth connection on /accounts.
# Without these, the "Connect Meta Ads" button shows a clear
# "setup required" state instead of pretending to connect.
# Create an app at https://developers.facebook.com — you'll need the
# Marketing API product added, and ads_read/ads_management permissions
# approved via App Review before real campaign data can be fetched.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Server-only — bypasses database security rules. Get this from Supabase:
# Project Settings → API → service_role key (NOT the anon key).
# Required only for real Whop payments (the webhook needs it to update
# a paying user's plan without that user being logged in at the time).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Whop payments — see supabase/migration-004-whop.sql and README for setup.
# Only used to verify webhook signatures now — checkout itself uses plain
# hosted checkout links (below), not an API call.
WHOP_COMPANY_API_KEY=apik_your_company_api_key
WHOP_WEBHOOK_SECRET=your_webhook_signing_secret
WHOP_SANDBOX=true
# Admin Control Center → Payments: your Whop company id (biz_...). Server-only.
# The company API key above also needs: payment:basic:read, member:basic:read,
# member:email:read, plan:basic:read.
WHOP_COMPANY_ID=biz_your_company_id

# The actual checkout link URL for each plan AND billing interval — create
# these in your Whop dashboard under Checkout links → Create checkout link
# (set "Redirect after checkout" there to
# https://creatively-ai-web.netlify.app/checkout/complete). These are plain
# URLs, not secrets, and are used directly by the browser. If you only sell
# monthly for now, leave the _ANNUAL ones blank — that plan's button will
# show "coming soon" instead of breaking.
NEXT_PUBLIC_WHOP_CHECKOUT_URL_STARTER_MONTHLY=https://whop.com/checkout/plan_xxxxxxxxxxxxx
NEXT_PUBLIC_WHOP_CHECKOUT_URL_STARTER_ANNUAL=https://whop.com/checkout/plan_xxxxxxxxxxxxx
NEXT_PUBLIC_WHOP_CHECKOUT_URL_PRO_MONTHLY=https://whop.com/checkout/plan_xxxxxxxxxxxxx
NEXT_PUBLIC_WHOP_CHECKOUT_URL_PRO_ANNUAL=https://whop.com/checkout/plan_xxxxxxxxxxxxx
NEXT_PUBLIC_WHOP_CHECKOUT_URL_BUSINESS_MONTHLY=https://whop.com/checkout/plan_xxxxxxxxxxxxx
NEXT_PUBLIC_WHOP_CHECKOUT_URL_BUSINESS_ANNUAL=https://whop.com/checkout/plan_xxxxxxxxxxxxx

# The plan_id (not the checkout link) behind each URL above — the webhook
# reads this to know which plan someone just bought. Find it on the plan's
# own page in your Whop dashboard (starts with plan_, NOT prod_).
WHOP_PLAN_ID_STARTER_MONTHLY=plan_xxxxxxxxxxxxx
WHOP_PLAN_ID_STARTER_ANNUAL=plan_xxxxxxxxxxxxx
WHOP_PLAN_ID_PRO_MONTHLY=plan_xxxxxxxxxxxxx
WHOP_PLAN_ID_PRO_ANNUAL=plan_xxxxxxxxxxxxx
WHOP_PLAN_ID_BUSINESS_MONTHLY=plan_xxxxxxxxxxxxx
WHOP_PLAN_ID_BUSINESS_ANNUAL=plan_xxxxxxxxxxxxx

# Optional — Cloudflare Turnstile CAPTCHA for the free-report form. If left
# blank, the free-report flow still works end-to-end, it just skips this
# extra bot-protection layer. Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Creative Strategy — ad image generation (Google Gemini). Server-side only.
# Without it, brand analysis and concepts still work; image generation shows a
# clear "not set up yet" state. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: a different Gemini image model that supports generateContent with
# imageConfig.aspectRatio (default: gemini-2.5-flash-image).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# The same key is used to listen to the soundtrack of uploaded video ads (Claude
# can't take audio). Without it, videos are still analyzed from their frames and
# the report says the audio wasn't analyzed. Optional model override:
# GEMINI_VIDEO_MODEL=gemini-flash-latest

# ── Admin Control Center (/admin) — see ADMIN.md ─────────────────────────────
# Comma-separated OWNER emails. Server-only. The account must exist and have a
# confirmed email. Owners can grant admin/viewer access to others in /admin/admins.
ADMIN_EMAILS=you@example.com
# Optional: serve the console ONLY on this hostname (e.g. admin.trycreatively.space).
# Leave unset to use https://<your-site>/admin.
# ADMIN_HOST=admin.trycreatively.space

# ── Loops (email) — server-only, never exposed to the browser ──
# API key from Loops → Settings → API. Without it, nothing is sent to Loops.
LOOPS_API_KEY=
# Optional: Loops mailing list id that free-report leads who tick the opt-in are
# added to (Loops → Audience → Lists → copy the list id). Leave empty to skip.
LOOPS_FREE_REPORT_LIST_ID=
